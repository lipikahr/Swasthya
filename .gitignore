# =========================
# Swasthya - Git Ignore
# =========================

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Django
db.sqlite3
db.sqlite3-journal

# -------------------------
# Node / React
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
build/
.vite/

# -------------------------
# Uploaded / Generated Media
# -------------------------
media/
uploads/

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Coverage / Test Output
# -------------------------
coverage/
.nyc_output/

# -------------------------
# Docker
# -------------------------
docker-compose.override.yml

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/


# -------------------------
# OS
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.swp
*.swo

# -------------------------
# Raw nutrition source data
# Keep original source artifacts out of Git
# unless explicitly approved.
# -------------------------
data/raw/