# ==========================================
# SWASTHYA - Environment Configuration
# ==========================================
# This file contains example configuration only.
# NEVER place real secrets in this file.
# Copy this file to .env for local development.

# ------------------------------------------
# Django
# ------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-real-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------
# PostgreSQL
# ------------------------------------------
POSTGRES_DB=swasthya
POSTGRES_USER=swasthya
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------
# Redis
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# Frontend / CORS
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------
# AI Provider
# ------------------------------------------
# Gemini will be the initial provider.
# Never put a real API key in this file.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# ------------------------------------------
# Storage
# ------------------------------------------
# Storage provider is intentionally not finalized yet.
# Add storage configuration only after that decision.