# Swasthya configuration template.
# Copy to `.env` in the repository root (same folder as docker-compose.yml) and
# fill in real values. NEVER commit the real .env file.
# Used by both Django (backend/) and Docker Compose.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Used when running Django on your own machine (host = localhost).
# Host port 5433 matches docker-compose.yml. Port 5432 is left for a local
# PostgreSQL install that may already be running. Inside Compose, Django uses
# host `db` on port 5432.
# Keep these credentials identical to the POSTGRES_* values below.
# The PostgreSQL password must use only URI-safe characters:
# letters, digits, -, _, ., ~
# docker-compose.yml builds DATABASE_URL directly from POSTGRES_PASSWORD,
# so characters such as @ : / # % ? would break the URL. No URL-encoding is applied.
DATABASE_URL=postgres://nutrition:change-me-123@localhost:5433/nutrition
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Used by docker-compose to create the PostgreSQL database, and to build the
# DATABASE_URL (host `db`) for the backend container.
POSTGRES_DB=nutrition
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=change-me-123
# Optional text agent. OpenRouter (ChatGPT, Claude, etc.) takes precedence when set.
# Create a key at https://openrouter.ai/keys — paste it on the line below (not in git).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://127.0.0.1:5173
OPENROUTER_APP_TITLE=Swasthya
# Google Gemini (optional). Leave empty when using OpenRouter.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash
# Daily calorie goal is met within this fraction of the calorie target (0.05 = 5%).
GOAL_CALORIE_TOLERANCE=0.05
# Sarvam Saaras v4 speech-to-text. Create a key at https://dashboard.sarvam.ai and paste it here.
# Voice recordings are sent to Sarvam only for transcription and are not stored by Swasthya.
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe
# Text-to-speech. Uses SARVAM_API_KEY when set. Leave empty to keep Listen unavailable.
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
# Password-reset emails. Console prints the message (including the link) in local logs.
# Production should set smtp and the EMAIL_HOST_* values. Do not put real secrets here.
FRONTEND_URL=http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Swasthya <noreply@localhost>
PASSWORD_RESET_TIMEOUT=86400
